[sub_resource type="GDScript" id="GDScript_2bl17"]
script/source = "extends Node2D
@export var asteroid_scene: PackedScene
@onready var player: CharacterBody2D = $\"../Player\"
var asteroid_count = 10
func spawn_asteroids():
	for i in range(asteroid_count):
		var asteroid = asteroid_scene.instantiate()
		asteroid.global_position = Vector2(randf_range(630, -630),randf_range(-4900, 100))
		get_tree().current_scene.add_child.call_deferred(asteroid)
func _process(delta: float) -> void:
	if player.position.y < -5853.0:
		asteroid_count += 1
		print (\"asteroid count increased\")
		spawn_asteroids()

func _ready():
	spawn_asteroids()
"

